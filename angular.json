{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "kalixto-ui": {
      "projectType": "library",
      "root": "projects/kalixto-ui",
      "sourceRoot": "projects/kalixto-ui/src",
      "prefix": "kx",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/kalixto-ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/kalixto-ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/kalixto-ui/tsconfig.spec.json"
          }
        }
      }
    },
    "sinergia-site": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/sinergia-site",
      "sourceRoot": "projects/sinergia-site/src",
      "prefix": "sn",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/sinergia-site/src/main.ts",
            "tsConfig": "projects/sinergia-site/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/sinergia-site/public"
              }
            ],
            "styles": [
              "node_modules/@fontsource-variable/source-serif-4/opsz.css",
              "node_modules/@fontsource/ibm-plex-sans/latin-400.css",
              "node_modules/@fontsource/ibm-plex-sans/latin-500.css",
              "node_modules/@fontsource/ibm-plex-sans/latin-600.css",
              "node_modules/@fontsource/ibm-plex-mono/latin-400.css",
              "node_modules/@fontsource/ibm-plex-mono/latin-500.css",
              "projects/sinergia-site/src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/kalixto-ui/src/styles",
                "projects/sinergia-site/src"
              ]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "sinergia-site:build:production"
            },
            "development": {
              "buildTarget": "sinergia-site:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}